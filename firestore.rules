rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isAuthenticated() && currentUserDoc().data.rol == 'admin';
    }

    function isMedicoOrAdmin() {
      return isAuthenticated() && currentUserDoc().data.rol in ['medico', 'admin'];
    }

    match /users/{userId} {
      // Solo el usuario autenticado puede leer su propio documento.
      allow read: if isAuthenticated() && request.auth.uid == userId;

      // Solo admin puede crear usuarios y solo con los campos esperados.
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'nombre',
          'email',
          'rol',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.nombre is string
        && request.resource.data.email is string
        && request.resource.data.rol in ['admin', 'medico', 'enfermera', 'asistente'];

      allow update, delete: if false;
    }

    match /pacientes/{pacienteId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isMedicoOrAdmin();
    }

    // Colección de admisiones y sus subcolecciones clínicas
    match /admisiones/{admissionId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isMedicoOrAdmin();

      // Subcolecciones clínicas: signos vitales, notas de enfermería, medicamentos, etc.
      match /vital_signs/{docId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && currentUserDoc().data.rol in ['enfermera', 'medico', 'admin'];
        allow update, delete: if isMedicoOrAdmin();
      }

      match /nursing_notes/{docId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && currentUserDoc().data.rol in ['enfermera', 'medico', 'admin'];
        allow update, delete: if isMedicoOrAdmin();
      }

      match /medication_records/{docId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && currentUserDoc().data.rol in ['enfermera', 'medico', 'admin'];
        allow update, delete: if isMedicoOrAdmin();
      }

      match /oxygen_records/{docId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && currentUserDoc().data.rol in ['enfermera', 'medico', 'admin'];
        allow update, delete: if isMedicoOrAdmin();
      }

      match /fluid_balance/{docId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && currentUserDoc().data.rol in ['enfermera', 'medico', 'admin'];
        allow update, delete: if isMedicoOrAdmin();
      }

      match /diet_orders/{docId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && currentUserDoc().data.rol in ['enfermera', 'medico', 'admin'];
        allow update, delete: if isMedicoOrAdmin();
      }
    }

    // Cierre por defecto para cualquier colección no declarada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
